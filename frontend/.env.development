# 开发环境
# VITE_USE_MOCK=false = 联调模式：所有请求走 vite 代理打到 127.0.0.1:8080 的真实后端
# 后端没起来（比如只想看页面效果）时改回 true，请求由 src/mock 本地应答，不依赖后端
VITE_APP_TITLE=企业差旅管理工具
VITE_API_BASE=/api
VITE_USE_MOCK=false

# AI 能力模式：mock = 前端规则模拟（后端 AI 未开发，页面会标注「本地演示」）
#                remote = 走后端真实 AI 接口
#                off    = 页面上不出现任何 AI 区块
# A-09/G-03/B-04/E-05/C-05 五个接口已接通，后端没起时这些区块会自动收起来，不影响别的流程
VITE_AI_MODE=remote
